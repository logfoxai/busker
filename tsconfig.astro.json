{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/env.d.ts",
    ".astro/types.d.ts",
    "src/content.config.ts",
    "src/components/**/*.astro",
    "src/components/**/*.ts",
    "src/overrides/**/*.astro",
    "src/pages/**/*.astro",
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "docs-site",
    "src/**/*.spec.ts",
    "src/integrations/**"
  ]
}
