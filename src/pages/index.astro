---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {Code} from '@astrojs/starlight/components';
import '../../busker.css';

const routineSource = `busk(root, {
    scene: 'home',
    start: [0.55, 0.3],
    steps: [
        {click: '[data-nav-item="alerts"]', wait: 900},
        {click: '[data-row="p0"]', wait: 1400},
        {click: '[data-why]', wait: 2200},
        {click: '[data-close]', wait: 2600},
        {click: '[data-nav-item="home"]', wait: 900},
        {to: [0.55, 0.3], wait: 900},
    ],
    routes: [
        {click: '[data-nav-item="home"]', scene: 'home'},
        {click: '[data-nav-item="alerts"]', scene: 'alerts'},
        {click: '[data-row="p0"]', scene: 'case'},
    ],
});`;
---

<StarlightPage
    frontmatter={{
        title: 'busker — scripted cursor demos that really click',
        description:
            'Drive a fake product UI with a routine, not a stopwatch. The cursor really clicks, so the page changes through your own handlers — and visitors can take over.',
        template: 'splash',
        tableOfContents: false,
        hero: {title: 'busker'},
        head: [{tag: 'title', content: 'busker — scripted cursor demos that really click'}],
    }}
>
    <div class="splash not-content">
        <header class="splash__hero">
            <h1>Scripted cursor demos that&nbsp;really click.</h1>
            <p class="splash__lead">
                Fake product demos rot because the cursor is on one timeline and the page is on
                another. Busker gets rid of the second one: it glides to an element and <strong
                    >really clicks it</strong
                >, so your own handlers change the page. Nothing to keep in sync, and the demo is
                live &mdash; click it yourself and busker steps aside.
            </p>
            <p class="splash__actions">
                <a class="splash__btn splash__btn--primary" href="/getting-started/">Get started</a>
                <a class="splash__btn" href="https://github.com/logfoxai/busker">GitHub</a>
            </p>
            <p class="splash__meta">Zero dependencies &middot; ~4kB &middot; MIT</p>
        </header>

        <section class="splash__demo">
            <div class="mock" data-mock>
                <div class="mock__chrome"><span></span><span></span><span></span></div>
                <div class="mock__body">
                    <nav class="mock__nav">
                        <button class="mock__nav-item" data-nav-item="home">Overview</button>
                        <button class="mock__nav-item" data-nav-item="alerts">Alerts</button>
                    </nav>

                    <div class="mock__main">
                        <section class="mock__scene" data-scene="home" data-nav="home">
                            <div class="mock__cards">
                                <div class="mock__card"><b>1.2M</b><span>events today</span></div>
                                <div class="mock__card"><b>3</b><span>open alerts</span></div>
                                <div class="mock__card"><b>99.98%</b><span>uptime</span></div>
                            </div>
                            <p class="mock__note">Nothing needs you right now.</p>
                        </section>

                        <section class="mock__scene" data-scene="alerts" data-nav="alerts">
                            <div class="mock__row mock__row--p0" data-row="p0">
                                <span class="mock__sev">P0</span>
                                <span class="mock__title">checkout: payment timeout</span>
                                <span class="mock__age">12m</span>
                            </div>
                            <div class="mock__row">
                                <span class="mock__sev mock__sev--p2">P2</span>
                                <span class="mock__title">worker: retry budget low</span>
                                <span class="mock__age">1h</span>
                            </div>
                            <div class="mock__row">
                                <span class="mock__sev mock__sev--p3">P3</span>
                                <span class="mock__title">cdn: cache miss spike</span>
                                <span class="mock__age">4h</span>
                            </div>
                        </section>

                        <section class="mock__scene" data-scene="case" data-nav="alerts">
                            <h4 class="mock__case-title">checkout: payment timeout</h4>
                            <p class="mock__note">427 events in 12 minutes, all from one region.</p>
                            <button class="mock__btn" data-why>Why is this happening?</button>
                            <div class="mock__panel" data-panel>
                                <b>Most likely</b>
                                <p>The payment provider's EU endpoint started returning 504s at 09:12.</p>
                                <button class="mock__btn mock__btn--quiet" data-close>Close</button>
                            </div>
                        </section>
                    </div>
                </div>
                <span data-cursor></span>
            </div>

            <p class="splash__caption">
                Live, not a video. Click anything and it is yours.
            </p>
        </section>

        <section class="splash__code">
            <h2>That demo, in full</h2>
            <p>
                Six beats and three routes. The scenes are not timed &mdash; they change because the
                cursor pressed a button, exactly as they do when you press it.
            </p>
            <Code code={routineSource} lang="typescript" />
        </section>
    </div>
</StarlightPage>

<script>
    import {busk} from '../index';

    const root = document.querySelector<HTMLElement>('[data-mock]');

    if (root) {
        // The panel is not a scene — busker clicked the button, this handler
        // does the rest, the same as it would for a real visitor.
        root.querySelector('[data-why]')?.addEventListener('click', () => {
            root.querySelector('[data-panel]')?.classList.add('is-open');
        });
        root.querySelector('[data-close]')?.addEventListener('click', () => {
            root.querySelector('[data-panel]')?.classList.remove('is-open');
        });

        busk(root, {
            scene: 'home',
            start: [0.55, 0.3],
            steps: [
                {click: '[data-nav-item="alerts"]', wait: 900},
                {click: '[data-row="p0"]', wait: 1400},
                {click: '[data-why]', wait: 2200},
                {click: '[data-close]', wait: 2600},
                {click: '[data-nav-item="home"]', wait: 900},
                {to: [0.55, 0.3], wait: 900},
            ],
            routes: [
                {click: '[data-nav-item="home"]', scene: 'home'},
                {click: '[data-nav-item="alerts"]', scene: 'alerts'},
                {click: '[data-row="p0"]', scene: 'case'},
                {click: '[data-why]', scene: 'case'},
                {click: '[data-close]', scene: 'case'},
            ],
        });
    }
</script>

<style>
    .splash {
        margin-inline: auto;
        max-width: 54rem;
    }

    .splash__hero {
        padding-block: 1rem 2.5rem;
        text-align: center;
    }

    .splash__hero h1 {
        font-size: clamp(2rem, 5vw, 3.1rem);
        line-height: 1.1;
        margin: 0 0 1rem;
    }

    .splash__lead {
        color: var(--sl-color-gray-2);
        font-size: 1.05rem;
        line-height: 1.65;
        margin-inline: auto;
        max-width: 42rem;
    }

    .splash__actions {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
        margin-top: 1.75rem;
    }

    .splash__btn {
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 999px;
        color: var(--sl-color-white);
        font-weight: 600;
        padding: 0.55rem 1.3rem;
        text-decoration: none;
    }

    .splash__btn--primary {
        background: var(--sl-color-accent);
        border-color: var(--sl-color-accent);
        color: var(--sl-color-black);
    }

    .splash__meta {
        color: var(--sl-color-gray-3);
        font-size: 0.85rem;
        margin-top: 1rem;
    }

    .splash__caption {
        color: var(--sl-color-gray-3);
        font-size: 0.85rem;
        text-align: center;
    }

    .splash__code {
        margin-top: 3.5rem;
    }

    /* ─── the mock ─────────────────────────────────────────────────────── */

    .mock {
        --busker-accent: var(--sl-color-accent-high);
        background: var(--sl-color-black);
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.75rem;
        overflow: hidden;
        user-select: none;
    }

    .mock__chrome {
        align-items: center;
        background: var(--sl-color-gray-6);
        border-bottom: 1px solid var(--sl-color-gray-5);
        display: flex;
        gap: 0.4rem;
        padding: 0.6rem 0.8rem;
    }

    .mock__chrome span {
        background: var(--sl-color-gray-4);
        border-radius: 999px;
        height: 0.55rem;
        width: 0.55rem;
    }

    .mock__body {
        display: grid;
        grid-template-columns: 9rem 1fr;
        min-height: 15rem;
    }

    .mock__nav {
        border-right: 1px solid var(--sl-color-gray-5);
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0.75rem 0.6rem;
    }

    .mock__nav-item {
        background: none;
        border: 0;
        border-radius: 0.4rem;
        color: var(--sl-color-gray-3);
        font: inherit;
        font-size: 0.85rem;
        padding: 0.4rem 0.6rem;
        text-align: left;
    }

    .mock__nav-item.is-active {
        background: var(--sl-color-gray-6);
        color: var(--sl-color-white);
        font-weight: 600;
    }

    .mock__main {
        padding: 1rem 1.1rem;
    }

    .mock__cards {
        display: grid;
        gap: 0.6rem;
        grid-template-columns: repeat(3, 1fr);
    }

    .mock__card {
        background: var(--sl-color-gray-6);
        border-radius: 0.5rem;
        display: grid;
        gap: 0.15rem;
        padding: 0.7rem 0.8rem;
    }

    .mock__card b {
        font-size: 1.15rem;
    }

    .mock__card span,
    .mock__note {
        color: var(--sl-color-gray-3);
        font-size: 0.8rem;
    }

    .mock__row {
        align-items: center;
        border-bottom: 1px solid var(--sl-color-gray-6);
        display: grid;
        gap: 0.7rem;
        grid-template-columns: 2.2rem 1fr auto;
        padding: 0.55rem 0.4rem;
    }

    .mock__row.is-hover {
        background: var(--sl-color-gray-6);
    }

    .mock__sev {
        background: #e5484d;
        border-radius: 0.3rem;
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.1rem 0.35rem;
        text-align: center;
    }

    .mock__sev--p2 {
        background: #f5a524;
        color: #2a1a00;
    }

    .mock__sev--p3 {
        background: var(--sl-color-gray-4);
        color: var(--sl-color-black);
    }

    .mock__title {
        font-size: 0.85rem;
    }

    .mock__age {
        color: var(--sl-color-gray-3);
        font-size: 0.78rem;
    }

    .mock__case-title {
        font-size: 1rem;
        margin: 0 0 0.35rem;
    }

    .mock__btn {
        background: var(--sl-color-accent);
        border: 0;
        border-radius: 0.4rem;
        color: var(--sl-color-black);
        font: inherit;
        font-size: 0.82rem;
        font-weight: 600;
        margin-top: 0.8rem;
        padding: 0.4rem 0.8rem;
    }

    .mock__btn--quiet {
        background: var(--sl-color-gray-5);
        color: var(--sl-color-white);
    }

    .mock__panel {
        background: var(--sl-color-gray-6);
        border-radius: 0.5rem;
        display: none;
        margin-top: 0.8rem;
        padding: 0.8rem 0.9rem;
    }

    .mock__panel.is-open {
        display: block;
    }

    .mock__panel b {
        font-size: 0.8rem;
    }

    .mock__panel p {
        color: var(--sl-color-gray-2);
        font-size: 0.85rem;
        margin: 0.3rem 0 0;
    }

    @media (max-width: 40rem) {
        .mock__body {
            grid-template-columns: 1fr;
        }

        .mock__nav {
            border-bottom: 1px solid var(--sl-color-gray-5);
            border-right: 0;
            flex-direction: row;
        }

        .mock__cards {
            grid-template-columns: 1fr;
        }
    }
</style>
