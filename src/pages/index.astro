---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {Code, LinkButton} from '@astrojs/starlight/components';
import '../../busker.css';
import '../demo/crema/mock.css';
import '../components/splash.css';

import cremaMockHtml from '../demo/crema/mock.html?raw';
import cremaMockCss from '../demo/crema/mock.css?raw';
import cremaMockTs from '../demo/crema/mock.ts?raw';

const PAGE_TITLE_ID = '_top';
---

<StarlightPage
    frontmatter={{
        title: 'busker — scripted cursor demos that click',
        description:
            'Drive a fake product UI with a routine, not a stopwatch. The cursor clicks, so the page changes through your own handlers — and visitors can take over.',
        template: 'splash',
        tableOfContents: false,
        hero: {title: 'busker'},
        head: [{tag: 'title', content: 'busker — scripted cursor demos that click'}],
    }}
>
    <div class="splash-page not-content">
        <section class="splash-hero">
            <h1 id={PAGE_TITLE_ID} class="sr-only" data-page-title>busker</h1>
            <h2 class="splash-hero__headline">Scripted cursor demos that&nbsp;click.</h2>
            <p class="splash-hero__lead">
                The easy way to build an <strong>interactive product mock</strong>. Write the
                screens in plain HTML, then link a click to the screen it opens &mdash; the same
                move as wiring frames in a Figma prototype, except this one ships on your page.
                Busker plays it back with a cursor that glides and clicks, so the mock
                changes through its own handlers. Click it yourself and busker steps aside.
            </p>
            <div class="splash-hero__actions">
                <LinkButton
                    href="/getting-started/"
                    variant="primary"
                    icon="right-arrow"
                    class="sl-link-button--forward"
                >
                    Get started
                </LinkButton>
                <LinkButton href="https://github.com/logfoxai/busker" variant="secondary" icon="github">
                    GitHub
                </LinkButton>
            </div>
            <p class="splash-hero__meta">Zero dependencies &middot; ~4kB &middot; MIT</p>
        </section>

        <div class="splash-home">
            <section class="splash__demo" set:html={cremaMockHtml} />

            <section class="splash__code">
                <h2>That demo, in full</h2>
                <p>
                    Markup, styles, and wiring in three files. Scenes change because the cursor
                    pressed a button &mdash; same as when you press it.
                </p>
                <h3 class="splash__code-file">mock.html</h3>
                <Code code={cremaMockHtml} lang="html" />
                <h3 class="splash__code-file">mock.css</h3>
                <Code code={cremaMockCss} lang="css" />
                <h3 class="splash__code-file">mock.ts</h3>
                <Code code={cremaMockTs} lang="typescript" />
            </section>
        </div>
    </div>
</StarlightPage>

<style is:global>
    /* Busker-only sections below the callspec-aligned splash hero. */

    .splash-home {
        margin-inline: auto;
        max-width: 54rem;
    }

    .splash-home .splash__code {
        margin-top: 3.5rem;

        & h2 {
            margin: 0 0 1rem;
            font-family: var(--cs-font-heading);
            color: var(--cs-ink);
        }

        & > p {
            margin: 0 0 1.5rem;
            color: var(--cs-muted);
        }

        & .splash__code-file {
            font-size: 0.95rem;
            font-weight: 600;
            margin: 2rem 0 0.75rem;
            color: var(--cs-ink);

            &:first-of-type {
                margin-top: 0;
            }
        }
    }
</style>

<script>
    import {initCremaDemo} from '../demo/crema/mock';

    initCremaDemo();
</script>
