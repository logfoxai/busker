---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {LinkButton} from '@astrojs/starlight/components';
import '../../busker.css';
import '../demo/crema/mock.css';
import '../components/splash.css';
import SplashCodeTabs from '../components/SplashCodeTabs.astro';
import SplashCopyAgentPromptButton from '../components/SplashCopyAgentPromptButton.astro';

import cremaDemoTs from '../demo/crema/demo.ts?raw';
import cremaMockHtml from '../demo/crema/mock.html?raw';
import cremaMockCss from '../demo/crema/mock.css?raw';
import cremaMockTs from '../demo/crema/mock.ts?raw';
import CursorClick from 'phosphor-astro/CursorClick.astro';
import {BUSKER_GITHUB} from '../components/splashAgentPrompt';

const PAGE_TITLE_ID = '_top';
const BUSKER_SKILL_ON_GITHUB = `${BUSKER_GITHUB}/blob/main/skills/busker/SKILL.md`;

const cremaCodeTabs = [
    {id: 'demo', label: 'demo.ts', lang: 'typescript', code: cremaDemoTs},
    {id: 'html', label: 'mock.html', lang: 'html', code: cremaMockHtml},
    {id: 'css', label: 'mock.css', lang: 'css', code: cremaMockCss},
    {id: 'mock', label: 'mock.ts', lang: 'typescript', code: cremaMockTs},
];
---

<StarlightPage
    frontmatter={{
        title: 'Busker — for product demos that really click',
        description:
            'Scripted cursor demos on live UI—click targets, handoff when visitors click. HTML/CSS/JS or any framework.',
        template: 'splash',
        tableOfContents: false,
        hero: {title: 'busker'},
        head: [{tag: 'title', content: 'busker — scripted cursor demos that click'}],
    }}
>
    <div class="splash-page not-content">
        <section class="splash-hero">
            <h1 id={PAGE_TITLE_ID} class="splash-hero__headline" data-page-title>
                Product demos that really click<!--
                --><CursorClick class="splash-hero__click-icon" aria-hidden="true" />
            </h1>
            <h2 class="splash-hero__lead">
                Ship a Figma-style product demo on your site: you build the screens, Busker loops a
                scripted cursor that clicks your real controls&mdash;live UI, not a video. Click targets
                show what is tappable; one visitor click ends the show and hands them the mock.
            </h2>
            <div class="splash-hero__cta">
                <div class="splash-hero__actions">
                    <LinkButton
                        href="/getting-started/"
                        variant="primary"
                        icon="right-arrow"
                        class="sl-link-button--forward"
                    >
                        Get started
                    </LinkButton>
                    <SplashCopyAgentPromptButton />
                    <LinkButton href="https://github.com/logfoxai/busker" variant="secondary" icon="github">
                        GitHub
                    </LinkButton>
                </div>
                <ul class="splash-hero__meta">
                    <li>Zero dependencies</li>
                    <li>~4kB</li>
                    <li>MIT</li>
                </ul>
            </div>
        </section>

        <div class="splash-home">
            <section class="splash__demo" set:html={cremaMockHtml} />

            <section class="splash__code">
                <h2>That demo, in full</h2>
                <p>
                    A short routine plus markup, styles, and wiring. The UI changes because the
                    cursor pressed a button &mdash; same as when you press it.
                </p>
                <SplashCodeTabs files={cremaCodeTabs} defaultId="demo" />
            </section>

            <section class="splash__prose">
                <h2>How you build it</h2>
                <p>
                    Plain HTML, CSS, and JavaScript is enough for straightforward demos like the one
                    above. Bigger UI or an app you already have? Use React, Vue, Svelte, or anything
                    else&mdash;Busker only needs a root element and selectors that match at runtime.
                </p>
                <p>
                    Layout, styles, and what each click does are yours. See{' '}
                    <a href="/getting-started/">Getting started</a> for install and wiring, and{' '}
                    <a href="/markup/">Markup</a> for what Busker reads from the DOM.
                </p>
            </section>

            <section class="splash__prose">
                <h2>What is a busk?</h2>
                <p>
                    A <strong>busker</strong> is someone who performs in public &mdash; music, magic, a
                    routine for people passing by. <strong>Busking</strong> is that kind of show. Busker
                    (the library) runs a scripted cursor through your UI the same way: a short performance
                    on your page, then the audience can take over.
                </p>
                <p>
                    We call each scripted mock a <strong>busk</strong>: one routine wired with
                    <code>busk()</code> on real markup, like the demo above.
                </p>
            </section>

            <section class="splash__prose">
                <h2>Coding agents</h2>
                <p>
                    Busker is a good fit for Cursor, Claude Code, and similar tools: small API, markdown
                    docs in GitHub, and a{' '}
                    <a href={BUSKER_SKILL_ON_GITHUB}>skill file</a> that teaches agents how to wire
                    busks and routines. The hero button <strong>For coding agents</strong> copies a starter
                    prompt that tells the agent to follow that skill and read docs via{' '}
                    <code>raw.githubusercontent.com</code> (not this HTML site). See{' '}
                    <a href="/coding-agents/">Working with coding agents</a> for install steps and the full
                    prompt template.
                </p>
            </section>
        </div>
    </div>
</StarlightPage>

<script>
    import {initCremaDemo} from '../demo/crema/demo';
    import {wireSplashAgentCopyButton} from '../components/splashAgentPrompt';

    initCremaDemo();
    wireSplashAgentCopyButton();
</script>
