---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {LinkButton} from '@astrojs/starlight/components';
import '../../busker.css';
import '../demo/crema/mock.css';
import '../components/splash.css';
import SplashCodeTabs from '../components/SplashCodeTabs.astro';
import SplashCopyAgentPromptButton from '../components/SplashCopyAgentPromptButton.astro';

import cremaDemoTs from '../demo/crema/demo.ts?raw';
import cremaMockHtml from '../demo/crema/mock.html?raw';
import cremaMockCss from '../demo/crema/mock.css?raw';
import cremaMockTs from '../demo/crema/mock.ts?raw';
import CursorClick from 'phosphor-astro/CursorClick.astro';

const PAGE_TITLE_ID = '_top';

const cremaCodeTabs = [
    {id: 'demo', label: 'demo.ts', lang: 'typescript', code: cremaDemoTs},
    {id: 'html', label: 'mock.html', lang: 'html', code: cremaMockHtml},
    {id: 'css', label: 'mock.css', lang: 'css', code: cremaMockCss},
    {id: 'mock', label: 'mock.ts', lang: 'typescript', code: cremaMockTs},
];
---

<StarlightPage
    frontmatter={{
        title: 'Busker — for product demos that really click',
        description:
            'Stop messing around with timeouts and complex state machines. Build an interactive, scripted product mock with any library or framework, or just basic HTML, CSS, and JavaScript.',
        template: 'splash',
        tableOfContents: false,
        hero: {title: 'busker'},
        head: [{tag: 'title', content: 'busker — scripted cursor demos that click'}],
    }}
>
    <div class="splash-page not-content">
        <section class="splash-hero">
            <h1 id={PAGE_TITLE_ID} class="splash-hero__headline" data-page-title>
                Product demos that really click<!--
                --><CursorClick class="splash-hero__click-icon" aria-hidden="true" />
            </h1>
            <h2 class="splash-hero__lead">
                The easy way to put a Figma-style product mock on your site. You build the screens
                like you already would; Busker runs the demo: cursor movement, clicks on your real
                controls, and playback that feels like a screen recording.                 It stays in sync because
                it is live UI, not a video or a pile of timers you have to re-tune. When a visitor
                clicks, the show stops and the mock is fully interactive, like a Figma prototype:
                real clicks, clear hotspots, and hints that invite them to explore on their own.
            </h2>
            <div class="splash-hero__cta">
                <div class="splash-hero__actions">
                    <LinkButton
                        href="/getting-started/"
                        variant="primary"
                        icon="right-arrow"
                        class="sl-link-button--forward"
                    >
                        Get started
                    </LinkButton>
                    <SplashCopyAgentPromptButton />
                    <LinkButton href="https://github.com/logfoxai/busker" variant="secondary" icon="github">
                        GitHub
                    </LinkButton>
                </div>
                <ul class="splash-hero__meta">
                    <li>Zero dependencies</li>
                    <li>~4kB</li>
                    <li>MIT</li>
                </ul>
            </div>
        </section>

        <div class="splash-home">
            <section class="splash__demo" set:html={cremaMockHtml} />

            <section class="splash__code">
                <h2>That demo, in full</h2>
                <p>
                    A short routine plus markup, styles, and wiring. The UI changes because the
                    cursor pressed a button &mdash; same as when you press it.
                </p>
                <SplashCodeTabs files={cremaCodeTabs} defaultId="demo" />
            </section>
        </div>
    </div>
</StarlightPage>

<script>
    import {initCremaDemo} from '../demo/crema/demo';
    import {wireSplashAgentCopyButton} from '../components/splashAgentPrompt';

    initCremaDemo();
    wireSplashAgentCopyButton();
</script>
